{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 5,
  "margin-bottom": -5,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "bluetooth",
    "pulseaudio",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-window-separator": "",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": "",
      "urgent": ""
    },
    "persistent-workspaces": {
      "*": 3, 
    },
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "year",
      "mode-mon-col"  : 3,
      "on-scroll"     : 1,
      "on-click-right": "mode",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },

  "cpu": {
    "format": " {usage}%"
  },
    
  "memory": {
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip": false
  },

  "network": {
    "format-ethernet": "",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
  },

  "bluetooth": {
    "format-on": "",
    "format-off": " off",
    "format-connected": " {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },


  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "  muted",
    "scroll-step": 5
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
