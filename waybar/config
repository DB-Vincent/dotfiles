{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "tray"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
		"format": "{name}",
		"format-icons": {
			"active": " ",
			"default": " "
		},
    "persistent_workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
    },
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "network": {
    "format-ethernet":"  {ifname}",
    "format-disconnected": "󰖪",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "scroll-step": 5
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
